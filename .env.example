#### Database ####
# Local DB
CS2_DB_PATH=assets/cs2.db

#### Offical LLM ####

# Deepseek API key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=YOUR_API_HERE
# Qwen API key from https://www.alibabacloud.com/help/en/model-studio/what-is-qwen-llm
QWEN_API_KEY=YOUR_API_HERE

#Moonshot API key from
KIMI_API_KEY=YOUR_API_HERE
# AiHubMix API key from https://aihubmix.com/
AIHUBMIX_API_KEY=YOUR_API_HERE

# Yi-Zhan API key from https://vip.yi-zhan.top/
YIZHAN_API_KEY=YOUR_API_HERE

#### Domestic CS2 Market (BUFF 网易) ####
# BUFF 登录 Cookie：登录 https://buff.163.com 后 F12 → Network → 筛选 api →
# 点任意请求 → 复制 Request Headers 里的 Cookie 整串
BUFF_COOKIE=YOUR_BUFF_COOKIE_HERE


